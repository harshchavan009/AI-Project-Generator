# Multi-stage production Dockerfile for CapstoneForge Backend
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir --user -r /app/backend/requirements.txt
RUN pip install --no-cache-dir --user psycopg2-binary asyncpg greenlet slowapi sentry-sdk bcrypt pyjwt cryptography

# Final runtime image
FROM python:3.12-slim AS runner

WORKDIR /app

# Create unprivileged system user for security
RUN groupadd -r capstone && useradd -r -g capstone -d /app capstone

COPY --from=builder /root/.local /home/capstone/.local
ENV PATH=/home/capstone/.local/bin:$PATH
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

COPY --chown=capstone:capstone backend /app/backend
COPY --chown=capstone:capstone alembic.ini /app/alembic.ini

# Create storage directory for models and logs
RUN mkdir -p /app/backend/data && chown -R capstone:capstone /app

USER capstone

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
