# ===================================================================
# CapstoneForge Production Environment Configuration Template
# Copy this file to .env and replace with production secrets.
# NEVER commit real credentials to source control.
# ===================================================================

# -------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------------------------
# Production PostgreSQL URL (asyncpg driver required for async backend):
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_db_password@localhost:5432/capstoneforge

# For local testing without PostgreSQL daemon (automatic fallback):
# DATABASE_URL=sqlite+aiosqlite:///backend/capstoneforge.db

# -------------------------------------------------------------
# Authentication & Cryptographic Keys (Required)
# -------------------------------------------------------------
# 256-bit cryptographically random secret string for JWT signing
JWT_SECRET_KEY=change_me_in_production_to_a_random_32_byte_hex_string_2026

# JWT Algorithm and Expiration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 32-byte urlsafe base64 string for Fernet AES-256 student PII encryption
# Generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=your_fernet_aes256_base64_encryption_key_here

# -------------------------------------------------------------
# External LLM Providers (Optional - Deterministic offline fallback active by default)
# -------------------------------------------------------------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
DEFAULT_PROVIDER=auto

# -------------------------------------------------------------
# Monitoring & Observability
# -------------------------------------------------------------
ENVIRONMENT=production
# Free-tier Sentry DSN (e.g. https://xxxx@o12345.ingest.sentry.io/67890)
SENTRY_DSN=
VITE_SENTRY_DSN=

# -------------------------------------------------------------
# CORS & Networking
# -------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80
PORT=8000
HOST=0.0.0.0
